VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site key (safe to expose client-side, like the anon key above) —
# from hcaptcha.com. Also requires enabling hCaptcha + pasting the SECRET key
# in Supabase: Authentication -> Settings -> Bot and Abuse Protection.
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# DSN from sentry.io (a new project there, React platform). Leave blank to
# disable error tracking entirely — the app checks for this and no-ops.
VITE_SENTRY_DSN=

# Your deployed domain, exactly as registered in your Plausible.io site
# settings (e.g. studycult.app). Analytics only start recording once this
# matches a domain Plausible actually knows about — a placeholder like
# "localhost" is fine for local dev and simply won't record anything.
VITE_PLAUSIBLE_DOMAIN=your-deployed-domain.com
